{
    "name": "ferry-calendar",
    "version": "0.1.0",
    "description": "Calendar views over your notes, with recurring events and read-only calendars derived from any folder's frontmatter.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "deploy": "node scripts/deploy.mjs",
        "build:deploy": "npm run build && npm run deploy",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "prettier --check 'src/**/*.ts*'",
        "fix-lint": "prettier --write 'src/**/*.ts*'",
        "compile": "tsc -noEmit --skipLibCheck",
        "prepare": "husky install",
        "test": "jest --ci --silent=true",
        "test-dev": "jest --watch",
        "coverage": "jest --coverage"
    },
    "keywords": [],
    "author": "TheMailman123",
    "license": "MIT",
    "comments": {
        "overrides": "obsidian-daily-notes-interface declares 'obsidian' as a runtime dependency pointing at a GitHub branch (github:obsidianmd/obsidian-api#master) rather than a peer dependency. That forces a git-protocol fetch. '$obsidian' pins every nested copy to the registry version this project already declares."
    },
    "overrides": {
        "obsidian": "$obsidian"
    },
    "devDependencies": {
        "@ladle/react": "^2.17.2",
        "@types/co": "^4.6.6",
        "@types/color": "^3.0.7",
        "@types/dav": "^1.7.7",
        "@types/deep-equal": "^1.0.4",
        "@types/ical": "^0.8.3",
        "@types/jest": "^29.5.14",
        "@types/luxon": "^2.4.0",
        "@types/node": "^22.10.2",
        "@types/react": "^17.0.93",
        "@types/react-dom": "^17.0.26",
        "builtin-modules": "^3.3.0",
        "esbuild": "^0.28.1",
        "fast-check": "^2.25.0",
        "husky": "^7.0.4",
        "jest": "^29.7.0",
        "obsidian": "^1.13.1",
        "prettier": "^2.8.8",
        "ts-jest": "^29.4.12",
        "tslib": "2.3.1",
        "typescript": "^5.9.3",
        "zod-fast-check": "^0.9.0"
    },
    "dependencies": {
        "@fullcalendar/core": "^5.10.1",
        "@fullcalendar/daygrid": "^5.10.1",
        "@fullcalendar/google-calendar": "^5.10.1",
        "@fullcalendar/icalendar": "^5.10.1",
        "@fullcalendar/interaction": "^5.10.1",
        "@fullcalendar/list": "^5.10.1",
        "@fullcalendar/rrule": "^5.11.2",
        "@fullcalendar/timegrid": "^5.10.1",
        "color": "^4.2.1",
        "dav": "^1.8.0",
        "deep-equal": "^2.1.0",
        "ical": "^0.8.0",
        "ical.js": "^1.5.0",
        "luxon": "^2.3.0",
        "moment": "^2.29.4",
        "obsidian-daily-notes-interface": "^0.9.4",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "rrule": "^2.7.2",
        "zod": "^3.21.4"
    }
}
